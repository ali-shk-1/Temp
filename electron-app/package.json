{
  "name": "school-mgmt-desktop",
  "version": "1.0.0",
  "description": "Desktop wrapper for the School Management app",
  "author": "you",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.schoolmgmt.desktop",
    "productName": "School Management",
    "files": ["**/*"],
    "extraResources": [
      { "from": "../school-backend/backend", "to": "school-backend/backend" },
      { "from": "../frontend", "to": "frontend" }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true
    },
    "linux": { "target": "AppImage" },
    "mac": { "target": "dmg" }
  }
}