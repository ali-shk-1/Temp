generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  role_id   Int    @id @default(autoincrement())
  role_name String @unique @db.VarChar(20)
  users     User[]

  @@map("roles")
}

model User {
  user_id       Int       @id @default(autoincrement())
  username      String    @unique @db.VarChar(50)
  password_hash String    @db.VarChar(255)
  role_id       Int?
  staff_id      Int?      @unique
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  last_login    DateTime?
  role          Role?     @relation(fields: [role_id], references: [role_id])
  staff         Staff?    @relation(fields: [staff_id], references: [staff_id])

  @@map("users")
}

model RolePermission {
  role_name      String   @db.VarChar
  permission_key String   @db.VarChar
  allowed        Boolean  @default(false)
  updated_at     DateTime @default(now())

  @@id([role_name, permission_key])
  @@map("role_permissions")
}

model RolePageVisibility {
  role_name  String   @db.VarChar
  page_key   String   @db.VarChar
  visible    Boolean  @default(true)
  updated_at DateTime @default(now())

  @@id([role_name, page_key])
  @@map("role_page_visibility")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Student {
  student_id      Int          @id @default(autoincrement())
  roll_no         Int
  section         String       @db.VarChar(10)
  class           String       @db.VarChar(10)
  first_name      String       @db.VarChar(50)
  last_name       String?      @db.VarChar(50)
  father_name     String?      @db.VarChar(100)
  contact_1       String?      @db.VarChar(15)
  contact_2       String?      @db.VarChar(15)
  address         String?
  admission_date  DateTime     @default(now()) @db.Date
  email           String?      @db.VarChar(255)
  photo_url       String?
  fee_start_month DateTime?    @db.Date
  gender          String?      @db.VarChar(10)
  fee_payments    FeePayment[]

  @@map("students")
}

model LeftStudent {
  left_student_id Int                     @id @default(autoincrement())
  old_student_id  Int?
  roll_no         Int?
  section         String?                 @db.VarChar
  class           String?                 @db.VarChar
  first_name      String                  @db.VarChar
  last_name       String?                 @db.VarChar
  father_name     String?                 @db.VarChar
  contact_1       String?                 @db.VarChar
  contact_2       String?                 @db.VarChar
  email           String?                 @db.VarChar
  photo_url       String?
  address         String?
  admission_date  DateTime?               @db.Date
  left_date       DateTime                @default(now()) @db.Date
  left_reason     String?
  fee_start_month DateTime?               @db.Date
  gender          String?                 @db.VarChar(10)
  fee_payments    LeftStudentFeePayment[]

  @@map("left_students")
}

model LeftStudentFeePayment {
  left_fee_payment_id Int         @id @default(autoincrement())
  left_student_id     Int
  old_student_id      Int?
  academic_month      DateTime?   @db.Date
  amount_due          Decimal?    @db.Decimal
  amount_paid         Decimal?    @db.Decimal
  payment_date        DateTime?
  left_student        LeftStudent @relation(fields: [left_student_id], references: [left_student_id], onDelete: Cascade)

  @@map("left_student_fee_payments")
}

model Designation {
  id    Int     @id @default(autoincrement())
  title String? @db.VarChar(50)
  staff Staff[]

  @@map("designations")
}

model Staff {
  staff_id       Int          @id @default(autoincrement())
  name           String       @db.VarChar(100)
  cnic           String       @unique @db.VarChar(15)
  phone_no       String?      @db.VarChar(15)
  salary         Decimal?     @db.Decimal(12, 2)
  designation_id Int?
  designation    Designation? @relation(fields: [designation_id], references: [id])
  users          User?

  @@map("staff")
}

model LeftStaff {
  left_staff_id  Int      @id @default(autoincrement())
  old_staff_id   Int?
  name           String   @db.VarChar
  cnic           String?  @db.VarChar
  phone_no       String?  @db.VarChar
  salary         Decimal? @db.Decimal
  designation_id Int?
  designation    String?  @db.VarChar
  left_date      DateTime @default(now()) @db.Date
  left_reason    String?

  @@map("left_staff")
}

model FeePayment {
  payment_id     Int             @id @default(autoincrement())
  student_id     Int?
  academic_month DateTime        @db.Date
  amount_due     Decimal?        @db.Decimal(10, 2)
  amount_paid    Decimal?        @default(0) @db.Decimal(10, 2)
  payment_date   DateTime?       @default(now())
  student        Student?        @relation(fields: [student_id], references: [student_id])
  receipts       PaymentReceipt?

  // Added for query performance: every fee/tracking page (Fee Tracking,
  // Student Tracking, student profile, monthly defaulters, daily report)
  // filters or joins on student_id and/or academic_month. Without these,
  // Postgres does a full table scan on fee_payments for each of those
  // pages, which gets slower as payment rows accumulate. Index-only —
  // does not alter, move, or delete any existing row.
  @@index([student_id])
  @@index([academic_month])
  @@index([student_id, academic_month])
  @@map("fee_payments")
}

model PaymentReceipt {
  receipt_no     Int         @id @default(autoincrement())
  payment_id     Int?        @unique
  student_id     Int
  roll_no        String?     @db.VarChar
  student_name   String?     @db.VarChar
  class          String?     @db.VarChar
  section        String?     @db.VarChar
  academic_month DateTime?   @db.Date
  amount_due     Decimal?    @default(0) @db.Decimal
  amount_paid    Decimal?    @default(0) @db.Decimal
  print_mode     String?     @default("paper") @db.VarChar
  issued_at      DateTime    @default(now())
  issued_by      String?     @db.VarChar
  payment        FeePayment? @relation(fields: [payment_id], references: [payment_id], onUpdate: NoAction)

  @@index([student_id])
  @@index([issued_at])
  @@map("payment_receipts")
}

model ExpenseCategory {
  category_id   Int       @id @default(autoincrement())
  category_name String?   @db.VarChar(50)
  expenses      Expense[]

  @@map("expense_categories")
}

model Expense {
  expense_id  Int              @id @default(autoincrement())
  category_id Int?
  amount      Decimal          @db.Decimal(12, 2)
  description String?
  created_at  DateTime?        @default(now()) @db.Date
  category    ExpenseCategory? @relation(fields: [category_id], references: [category_id])

  @@map("expenses")
}
